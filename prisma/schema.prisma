generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FAQ {
  id          String   @id
  question    String
  answer      String
  category    String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([category])
  @@index([isPublished])
  @@index([sortOrder])
}

model Feedback {
  id        String   @id
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  rating    Int?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime

  @@index([createdAt])
  @@index([isRead])
}

model GoogleReview {
  id             String   @id
  googleReviewId String   @unique
  authorName     String
  authorPhotoUrl String?
  rating         Int
  text           String?
  relativeTime   String
  reviewTime     DateTime
  language       String   @default("nl")
  sortOrder      String
  isVisible      Boolean  @default(true)
  fetchedAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime

  @@index([isVisible])
  @@index([rating])
  @@index([reviewTime])
  @@index([sortOrder])
}

model PageContent {
  id        String   @id
  page      String
  section   String
  key       String
  value     String
  type      String   @default("text")
  updatedAt DateTime

  @@unique([page, section, key])
  @@index([page])
}

model Post {
  id        String   @id
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

model PriceTier {
  id              String           @id
  workshopId      String
  variantId       String?
  groupSize       String
  minParticipants Int?
  maxParticipants Int?
  priceExclBtw    Float
  priceInclBtw    Float
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  WorkshopVariant WorkshopVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  Workshop        Workshop         @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([workshopId])
}

model Recipe {
  id          String   @id
  title       String
  slug        String   @unique
  description String?
  imageUrl    String?
  prepTime    Int?
  cookTime    Int?
  servings    Int?
  difficulty  String?
  category    String?
  ingredients String[]
  steps       String[]
  tips        String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([category])
  @@index([isPublished])
  @@index([slug])
}

model SiteSetting {
  id        String   @id
  key       String   @unique
  value     String
  type      String   @default("text")
  updatedAt DateTime
}

model TeamMember {
  id          String   @id
  name        String
  role        String
  origin      String?
  bio         String
  quote       String?
  image       String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([isPublished])
  @@index([sortOrder])
}

model Testimonial {
  id          String   @id
  quote       String
  author      String
  role        String?
  company     String?
  rating      Int      @default(5)
  image       String?
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([isFeatured])
  @@index([isPublished])
}

model User {
  id        String   @id
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  bio       String?
  role      String   @default("user")
  Post      Post[]

  @@index([role])
}

model Workshop {
  id              String            @id
  slug            String            @unique
  title           String
  subtitle        String
  description     String
  longDescription String?
  image           String?
  video           String?
  duration        String
  groupSize       String
  location        String
  categories      String[]
  includes        String[]
  isPublished     Boolean           @default(true)
  sortOrder       Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  PriceTier       PriceTier[]
  WorkshopVariant WorkshopVariant[]

  @@index([isPublished])
  @@index([slug])
  @@index([sortOrder])
}

model WorkshopConfig {
  id               String   @id
  type             String
  participantCount Int
  workshops        String[]
  location         String
  customCity       String?
  date             String?
  time             String?
  duration         Float?
  name             String
  email            String
  createdAt        DateTime @default(now())
  updatedAt        DateTime
  phone            String?

  @@index([createdAt])
  @@index([email])
}

model WorkshopVariant {
  id          String      @id
  workshopId  String
  name        String
  description String
  duration    String
  includes    String[]
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  PriceTier   PriceTier[]
  Workshop    Workshop    @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId])
}

model google_reviews_cache {
  id               String   @id @default("singleton")
  placeId          String
  placeName        String?
  averageRating    Float?
  totalReviewCount Int?
  lastFetchedAt    DateTime @default(now())
  fetchErrorCount  Int      @default(0)
  lastErrorMessage String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime
}

// ============================================================
// MEDIA GALLERY
// Workshop photos uploaded via backend admin for website display
// ============================================================
model MediaGallery {
  id           Int       @id @default(autoincrement())
  workshopId   Int?      @map("workshop_id") // Optional link to confirmed workshop

  // Vercel Blob Storage
  blobUrl      String    @map("blob_url")
  fileName     String    @map("file_name")
  fileSize     Int?      @map("file_size")
  mimeType     String    @map("mime_type")

  // Image Metadata
  width        Int?
  height       Int?
  caption      String?
  altText      String?   @map("alt_text")
  takenAt      DateTime? @map("taken_at")

  // Organization
  displayOrder Int       @default(0) @map("display_order")
  // Categories: Content images (workshop, setup, cooking, results, group, food, venue)
  //             Site assets (site-hero-video, site-hero-poster, site-logo, site-og)
  category     String?   @default("workshop")

  // Tagging
  tags         Json?     // Array of strings for search/filtering

  // Permissions & Display
  isPublic           Boolean @default(false) @map("is_public")
  showOnWebsite      Boolean @default(false) @map("show_on_website")
  featuredOnHomepage Boolean @default(false) @map("featured_on_homepage")

  // Uploaded By
  uploadedBy   String?   @map("uploaded_by")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")

  // Metadata
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("media_gallery")
  @@index([showOnWebsite])
  @@index([featuredOnHomepage])
  @@index([category])
  @@index([displayOrder])
}

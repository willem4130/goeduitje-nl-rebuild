generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FAQ {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([sortOrder])
}

model Feedback {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  rating    Int?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  firstName     String?
  lastName      String?
  eventDate     String?
  eventLocation String?
  whatWasBest   String?
  whatToImprove String?

  @@index([createdAt])
  @@index([isRead])
}

model GoogleReview {
  id             String   @id @default(cuid())
  googleReviewId String   @unique
  authorName     String
  authorPhotoUrl String?
  rating         Int
  text           String?
  relativeTime   String
  reviewTime     DateTime
  language       String   @default("nl")
  sortOrder      String
  isVisible      Boolean  @default(true)
  fetchedAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isVisible])
  @@index([rating])
  @@index([reviewTime])
  @@index([sortOrder])
}

model PageContent {
  id        String   @id @default(cuid())
  page      String
  section   String
  key       String
  value     String
  type      String   @default("text")
  updatedAt DateTime @updatedAt

  @@unique([page, section, key])
  @@index([page])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

model PriceTier {
  id              String           @id @default(cuid())
  workshopId      String
  variantId       String?
  groupSize       String
  minParticipants Int?
  maxParticipants Int?
  priceExclBtw    Float
  priceInclBtw    Float
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  WorkshopVariant WorkshopVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  Workshop        Workshop         @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([workshopId])
}

model Recipe {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  imageUrl    String?
  prepTime    Int?
  cookTime    Int?
  servings    Int?
  difficulty  String?
  category    String?
  ingredients String[]
  steps       String[]
  tips        String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([slug])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("text")
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  origin      String?
  bio         String
  quote       String?
  image       String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@index([sortOrder])
}

model Testimonial {
  id          String   @id @default(cuid())
  quote       String
  author      String
  role        String?
  company     String?
  rating      Int      @default(5)
  image       String?
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isFeatured])
  @@index([isPublished])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bio       String?
  role      String   @default("user")
  Post      Post[]

  @@index([role])
}

model Workshop {
  id              String            @id @default(cuid())
  slug            String            @unique
  title           String
  subtitle        String
  description     String
  longDescription String?
  image           String?
  video           String?
  duration        String
  groupSize       String
  location        String
  categories      String[]
  includes        String[]
  isPublished     Boolean           @default(true)
  sortOrder       Int               @default(0)
  minParticipants Int?
  maxParticipants Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  priceTiers      PriceTier[]
  variants        WorkshopVariant[]

  @@index([isPublished])
  @@index([slug])
  @@index([sortOrder])
}

// ============================================================
// OPEN WORKSHOP SESSIONS
// Individual open kookworkshop dates managed via admin backend
// ============================================================
model OpenWorkshopSession {
  id             String    @id @default(cuid())
  date           DateTime
  startTime      String    // "14:00"
  endTime        String    // "16:30"
  location       String    @default("Nijmegen")
  maxCapacity    Int       @default(12)
  pricePerPerson Float     @default(60)
  isActive       Boolean   @default(true)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bookings       Booking[]

  @@index([date])
  @@index([isActive])
}

model Booking {
  id                 String   @id @default(cuid())
  stripeSessionId    String?  @unique
  stripePaymentId    String?

  // Customer info
  firstName          String
  lastName           String
  email              String
  numberOfPeople     Int

  // Workshop info
  workshopId         String?    // Legacy: ID from old hardcoded open-workshops.ts
  workshopDate       String?    // Display date string
  sessionId          String?    // FK to OpenWorkshopSession
  session            OpenWorkshopSession? @relation(fields: [sessionId], references: [id])

  // Dietary
  dietaryRequirement String?
  allergies          String?

  // Gift card
  hasGiftCard        Boolean  @default(false)
  giftCardId         String?
  giftCardValue      Float?

  // Payment
  totalPrice         Float
  remainingAmount    Float
  amountPaid         Float?
  currency           String   @default("eur")
  paymentMethod      String?  // "gift_card", "stripe", "gift_card_partial"
  paymentStatus      String   @default("pending") // pending, paid, failed, refunded

  // Metadata
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([email])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([sessionId])
}

model WorkshopConfig {
  id               String   @id @default(cuid())
  type             String
  participantCount Int
  workshops        String[]
  location         String
  customCity       String?
  date             String?
  time             String?
  duration         Float?
  name             String
  email            String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  phone            String?
  companyName      String?
  btwNumber        String?

  @@index([createdAt])
  @@index([email])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  subject   String
  body      String
  variables String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model EmailLog {
  id           String   @id @default(cuid())
  templateKey  String
  to           String
  subject      String
  body         String
  variables    Json
  status       String   @default("sent")
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([templateKey])
  @@index([createdAt])
  @@index([to])
}

model WorkshopVariant {
  id          String      @id @default(cuid())
  workshopId  String
  name        String
  description String
  duration    String
  includes    String[]
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  priceTiers  PriceTier[]
  Workshop    Workshop    @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId])
}

model google_reviews_cache {
  id               String   @id @default("singleton")
  placeId          String
  placeName        String?
  averageRating    Float?
  totalReviewCount Int?
  lastFetchedAt    DateTime @default(now())
  fetchErrorCount  Int      @default(0)
  lastErrorMessage String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ============================================================
// SESSION CHANGES
// Development change tracking for client validation
// Managed via backend admin at /wijzigingen
// ============================================================
model SessionChange {
  id              String    @id @default(cuid())
  title           String
  description     String?
  category        String?   // Contact, Navigation, Content, Design, Feature, Bug
  filesChanged    String[]  // Array of file paths
  changeDetails   String[]  // Bullet points describing the change
  viewUrl         String?   // Link to see change live
  screenshotUrls  String[]  // Multiple screenshot/image URLs (Vercel Blob)
  screenshotPaths String[]  // Blob paths for deletion
  status          String    @default("pending") // pending, approved, needs_changes, in_progress
  addedBy         String?   @default("developer") // developer or client
  deletedAt       DateTime? // Soft delete timestamp
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  feedback      SessionChangeFeedback[]

  @@map("session_changes")
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([deletedAt])
}

model SessionChangeFeedback {
  id              String   @id @default(cuid())
  changeId        String
  feedbackText    String?
  screenshotUrls  String[] // Multiple Vercel Blob URLs
  screenshotPaths String[] // Blob paths for deletion
  createdAt       DateTime @default(now())

  // Relations
  change         SessionChange @relation(fields: [changeId], references: [id], onDelete: Cascade)

  @@map("session_change_feedback")
  @@index([changeId])
}

// Status history for backup/restore of client approvals
model SessionChangeStatusHistory {
  id        String   @id @default(cuid())
  changeId  String
  status    String   // The status that was set
  changedBy String?  // Who made the change (client, developer, system)
  note      String?  // Optional note about the change
  createdAt DateTime @default(now())

  @@map("session_change_status_history")
  @@index([changeId])
  @@index([createdAt])
}

// ============================================================
// MEDIA GALLERY
// Workshop photos uploaded via backend admin for website display
// ============================================================
model MediaGallery {
  id           Int       @id @default(autoincrement())
  workshopId   Int?      @map("workshop_id") // Optional link to confirmed workshop

  // Vercel Blob Storage
  blobUrl      String    @map("blob_url")
  fileName     String    @map("file_name")
  fileSize     Int?      @map("file_size")
  mimeType     String    @map("mime_type")

  // Image Metadata
  width        Int?
  height       Int?
  caption      String?
  altText      String?   @map("alt_text")
  takenAt      DateTime? @map("taken_at")

  // Organization
  displayOrder Int       @default(0) @map("display_order")
  // Categories: Content images (workshop, setup, cooking, results, group, food, venue)
  //             Site assets (site-hero-video, site-hero-poster, site-logo, site-og)
  category     String?   @default("workshop")

  // Tagging
  tags         Json?     // Array of strings for search/filtering

  // Permissions & Display
  isPublic           Boolean @default(false) @map("is_public")
  showOnWebsite      Boolean @default(false) @map("show_on_website")
  featuredOnHomepage Boolean @default(false) @map("featured_on_homepage")

  // Uploaded By
  uploadedBy   String?   @map("uploaded_by")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")

  // Metadata
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("media_gallery")
  @@index([showOnWebsite])
  @@index([featuredOnHomepage])
  @@index([category])
  @@index([displayOrder])
}

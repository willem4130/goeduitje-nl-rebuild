// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User accounts for admin access
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("user") // user, moderator, admin
  bio       String?
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

model WorkshopConfig {
  id               String   @id @default(cuid())
  type             String   // "zakelijk" or "particulier"
  participantCount Int
  workshops        String[] // Array of workshop IDs
  location         String   // "Nijmegen", "Arnhem", "Amersfoort", or "other"
  customCity       String?  // Custom city name when location is "other"
  date             String?  // ISO date string or "TBD"
  time             String?  // Time string or "TBD"
  duration         Float?   // Uitje duration in hours (supports 0.5 increments)
  name             String
  email            String
  phone            String?  // Contact phone number
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
}

// Google Reviews - cached from Google Places API
model GoogleReview {
  id              String   @id @default(cuid())
  googleReviewId  String   @unique // Derived from author + timestamp for deduplication
  authorName      String
  authorPhotoUrl  String?
  rating          Int      // 1-5 stars
  text            String?  // Review text (can be empty)
  relativeTime    String   // "2 weeks ago" etc.
  reviewTime      DateTime // Actual timestamp of the review
  language        String   @default("nl")
  sortOrder       String   // "most_relevant" or "newest"
  isVisible       Boolean  @default(true) // Admin can hide reviews
  fetchedAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([rating])
  @@index([reviewTime])
  @@index([isVisible])
  @@index([sortOrder])
}

// Cache metadata for tracking Google API fetch timestamps
model GoogleReviewsCache {
  id               String   @id @default("singleton")
  placeId          String
  placeName        String?
  averageRating    Float?
  totalReviewCount Int?
  lastFetchedAt    DateTime @default(now())
  fetchErrorCount  Int      @default(0)
  lastErrorMessage String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("google_reviews_cache")
}

// Recipe model for the /recepten page
model Recipe {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  imageUrl    String?
  prepTime    Int?     // In minutes
  cookTime    Int?     // In minutes
  servings    Int?
  difficulty  String?  // "makkelijk", "gemiddeld", "moeilijk"
  category    String?  // "Arabisch", "Turks", "Mediterraan", etc.
  ingredients String[] // Array of ingredients
  steps       String[] // Array of cooking steps
  tips        String?  // Cooking tips
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isPublished])
}

// Feedback model for the /feedback page
model Feedback {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  rating    Int?     // 1-5 stars (optional)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@index([createdAt])
}

// Workshop model - main uitje definitions
model Workshop {
  id              String           @id @default(cuid())
  slug            String           @unique
  title           String
  subtitle        String
  description     String
  longDescription String?
  image           String?
  video           String?
  duration        String
  groupSize       String
  location        String
  categories      String[]
  includes        String[]
  isPublished     Boolean          @default(true)
  sortOrder       Int              @default(0)
  priceTiers      PriceTier[]
  variants        WorkshopVariant[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@index([sortOrder])
}

// Price tier for workshops
model PriceTier {
  id             String   @id @default(cuid())
  workshopId     String
  workshop       Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  variantId      String?
  variant        WorkshopVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  groupSize      String   // "8-10 personen", "16+ personen", etc.
  minParticipants Int?
  maxParticipants Int?
  priceExclBtw   Float
  priceInclBtw   Float
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([workshopId])
  @@index([variantId])
}

// Workshop variants (e.g., Arabisch, Dessert, Oogsten for Kookworkshop)
model WorkshopVariant {
  id          String      @id @default(cuid())
  workshopId  String
  workshop    Workshop    @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  name        String
  description String
  duration    String
  includes    String[]
  sortOrder   Int         @default(0)
  priceTiers  PriceTier[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([workshopId])
}

// Site settings - key/value pairs for admin configuration
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("text") // text, boolean, number, json
  updatedAt DateTime @updatedAt
}

// FAQ entries
model FAQ {
  id          String   @id @default(cuid())
  question    String
  answer      String   // Rich text (HTML)
  category    String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([sortOrder])
}

// Team members
model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  origin      String?
  bio         String   // Rich text (HTML)
  quote       String?
  image       String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@index([sortOrder])
}

// Custom testimonials (separate from Google Reviews)
model Testimonial {
  id          String   @id @default(cuid())
  quote       String
  author      String
  role        String?
  company     String?
  rating      Int      @default(5)
  image       String?
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isFeatured])
  @@index([isPublished])
}

// Page content - CMS for editable text blocks
model PageContent {
  id        String   @id @default(cuid())
  page      String   // "homepage", "ons-verhaal", etc.
  section   String   // "hero", "cta", "intro"
  key       String   // "title", "description", "buttonText"
  value     String   // Content (plain text or HTML)
  type      String   @default("text") // text, richtext, url
  updatedAt DateTime @updatedAt

  @@unique([page, section, key])
  @@index([page])
}

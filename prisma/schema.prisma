// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Example models - customize as needed
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  posts     Post[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

model WorkshopConfig {
  id               String   @id @default(cuid())
  type             String   // "zakelijk" or "particulier"
  participantCount Int
  workshops        String[] // Array of workshop IDs
  location         String   // "Nijmegen", "Arnhem", "Amersfoort", or "other"
  customCity       String?  // Custom city name when location is "other"
  date             String?  // ISO date string or "TBD"
  time             String?  // Time string or "TBD"
  duration         Float?   // Uitje duration in hours (supports 0.5 increments)
  name             String
  email            String
  phone            String?  // Contact phone number
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
}

// Google Reviews - cached from Google Places API
model GoogleReview {
  id              String   @id @default(cuid())
  googleReviewId  String   @unique // Derived from author + timestamp for deduplication
  authorName      String
  authorPhotoUrl  String?
  rating          Int      // 1-5 stars
  text            String?  // Review text (can be empty)
  relativeTime    String   // "2 weeks ago" etc.
  reviewTime      DateTime // Actual timestamp of the review
  language        String   @default("nl")
  sortOrder       String   // "most_relevant" or "newest"
  isVisible       Boolean  @default(true) // Admin can hide reviews
  fetchedAt       DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([rating])
  @@index([reviewTime])
  @@index([isVisible])
  @@index([sortOrder])
}

// Cache metadata for tracking Google API fetch timestamps
model GoogleReviewsCache {
  id               String   @id @default("singleton")
  placeId          String
  placeName        String?
  averageRating    Float?
  totalReviewCount Int?
  lastFetchedAt    DateTime @default(now())
  fetchErrorCount  Int      @default(0)
  lastErrorMessage String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("google_reviews_cache")
}

// Recipe model for the /recepten page
model Recipe {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  imageUrl    String?
  prepTime    Int?     // In minutes
  cookTime    Int?     // In minutes
  servings    Int?
  difficulty  String?  // "makkelijk", "gemiddeld", "moeilijk"
  category    String?  // "Arabisch", "Turks", "Mediterraan", etc.
  ingredients String[] // Array of ingredients
  steps       String[] // Array of cooking steps
  tips        String?  // Cooking tips
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([category])
  @@index([isPublished])
}

// Feedback model for the /feedback page
model Feedback {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  rating    Int?     // 1-5 stars (optional)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@index([createdAt])
}

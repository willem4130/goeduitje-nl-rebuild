generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FAQ {
  id          String   @id @default(cuid())
  question    String
  answer      String
  category    String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([sortOrder])
}

model Feedback {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  rating    Int?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  firstName     String?
  lastName      String?
  eventDate     String?
  eventLocation String?
  whatWasBest   String?
  whatToImprove String?

  @@index([createdAt])
  @@index([isRead])
}

model GoogleReview {
  id             String   @id @default(cuid())
  googleReviewId String   @unique
  authorName     String
  authorPhotoUrl String?
  rating         Int
  text           String?
  relativeTime   String
  reviewTime     DateTime
  language       String   @default("nl")
  sortOrder      String
  isVisible      Boolean  @default(true)
  fetchedAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([isVisible])
  @@index([rating])
  @@index([reviewTime])
  @@index([sortOrder])
}

model PageContent {
  id        String   @id @default(cuid())
  page      String
  section   String
  key       String
  value     String
  type      String   @default("text")
  updatedAt DateTime @updatedAt

  @@unique([page, section, key])
  @@index([page])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [authorId], references: [id])

  @@index([authorId])
}

model PriceTier {
  id              String           @id @default(cuid())
  workshopId      String
  variantId       String?
  groupSize       String
  minParticipants Int?
  maxParticipants Int?
  priceExclBtw    Float
  priceInclBtw    Float
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  WorkshopVariant WorkshopVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  Workshop        Workshop         @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@index([workshopId])
}

model Recipe {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  imageUrl    String?
  prepTime    Int?
  cookTime    Int?
  servings    Int?
  difficulty  String?
  category    String?
  ingredients String[]
  steps       String[]
  tips        String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
  @@index([slug])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("text")
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String
  role        String
  origin      String?
  bio         String
  quote       String?
  image       String?
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@index([sortOrder])
}

model Testimonial {
  id          String   @id @default(cuid())
  quote       String
  author      String
  role        String?
  company     String?
  rating      Int      @default(5)
  image       String?
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isFeatured])
  @@index([isPublished])
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bio       String?
  role      String   @default("user")
  Post      Post[]

  @@index([role])
}

model Workshop {
  id              String            @id @default(cuid())
  slug            String            @unique
  title           String
  subtitle        String
  description     String
  longDescription String?
  image           String?
  video           String?
  duration        String
  groupSize       String
  location        String
  categories      String[]
  includes        String[]
  isPublished     Boolean           @default(true)
  sortOrder       Int               @default(0)
  minParticipants Int?
  maxParticipants Int?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  priceTiers      PriceTier[]
  variants        WorkshopVariant[]

  @@index([isPublished])
  @@index([slug])
  @@index([sortOrder])
}

// ============================================================
// OPEN WORKSHOP SESSIONS
// Individual open kookworkshop dates managed via admin backend
// ============================================================
model OpenWorkshopSession {
  id             String    @id @default(cuid())
  date           DateTime
  startTime      String    // "14:00"
  endTime        String    // "16:30"
  location       String    @default("Nijmegen")
  maxCapacity    Int       @default(12)
  pricePerPerson Float     @default(60)
  isActive       Boolean   @default(true)
  isFull         Boolean   @default(false)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bookings       Booking[]

  @@index([date])
  @@index([isActive])
}

model Booking {
  id                 String   @id @default(cuid())
  stripeSessionId    String?  @unique
  stripePaymentId    String?

  // Customer info
  firstName          String
  lastName           String
  email              String
  numberOfPeople     Int

  // Workshop info
  workshopId         String?    // Legacy: ID from old hardcoded open-workshops.ts
  workshopDate       String?    // Display date string
  sessionId          String?    // FK to OpenWorkshopSession
  session            OpenWorkshopSession? @relation(fields: [sessionId], references: [id])

  // Dietary
  dietaryRequirement String?
  allergies          String?

  // Gift card
  hasGiftCard        Boolean  @default(false)
  giftCardId         String?
  giftCardValue      Float?

  // Payment
  totalPrice         Float
  remainingAmount    Float
  amountPaid         Float?
  currency           String   @default("eur")
  paymentMethod      String?  // "gift_card", "stripe", "gift_card_partial"
  paymentStatus      String   @default("pending") // pending, paid, failed, refunded

  // Metadata
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([email])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([sessionId])
}

model WorkshopConfig {
  id               String   @id @default(cuid())
  type             String
  participantCount Int
  workshops        String[]
  location         String
  customCity       String?
  date             String?
  time             String?
  duration         Float?
  name             String
  email            String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  phone            String?
  companyName       String?
  btwNumber         String?
  selectedVariants  Json?

  workshopRequest  WorkshopRequest?

  @@index([createdAt])
  @@index([email])
}

// ============================================================
// WORKSHOP REQUESTS
// Incoming workshop inquiries (manual + website configurator)
// Managed via backend admin, written from frontend on configurator submit
// ============================================================
model WorkshopRequest {
  id                      Int       @id @default(autoincrement())
  status                  String    @default("leeg")
  contactName             String    @map("contact_name")
  email                   String
  phone                   String?
  organization            String?
  activityType            String    @map("activity_type")
  preferredDate           String?   @map("preferred_date")
  alternativeDate         String?   @map("alternative_date")
  participants            Int
  ageGroup                String?   @map("age_group")
  location                String?
  hasOwnLocation          Boolean?  @default(false) @map("has_own_location")
  travelDistance           Int?      @map("travel_distance")
  specialRequirements     String?   @map("special_requirements")
  dietaryRestrictions     String?   @map("dietary_restrictions")
  accessibilityNeeds      String?   @map("accessibility_needs")
  quotedPrice             Decimal?  @map("quoted_price") @db.Decimal(10, 2)
  locationFee             Decimal?  @map("location_fee") @db.Decimal(10, 2)
  finalPrice              Decimal?  @map("final_price") @db.Decimal(10, 2)
  priceIncludesVat        Boolean?  @default(false) @map("price_includes_vat")
  quoteEmailSentAt        DateTime? @map("quote_email_sent_at")
  quotePdfUrl             String?   @map("quote_pdf_url")
  aiGeneratedEmailContent String?   @map("ai_generated_email_content")
  notes                   String?
  source                  String?   @default("website")
  sourceDetail            String?   @map("source_detail")
  configId                String?   @unique @map("config_id")
  config                  WorkshopConfig? @relation(fields: [configId], references: [id])
  cancelReason            String?   @map("cancel_reason")
  noOrderReason           String?   @map("no_order_reason")
  nextFollowUpDate        DateTime? @map("next_follow_up_date")
  assignedToId            Int?      @map("assigned_to_id")
  assignedTo              AdminUser? @relation(fields: [assignedToId], references: [id])
  priceType               String?   @map("price_type")
  drinksCost              String?   @map("drinks_cost")
  allergies               String?
  seatingOnCushions       Boolean?  @default(false) @map("seating_on_cushions")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  emailConversation  EmailConversation?
  statusAuditLogs    StatusAuditLog[]
  quoteVersions      QuoteVersion[]
  confirmedWorkshop  ConfirmedWorkshop?

  @@map("workshop_requests")
  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([assignedToId])
}

// ============================================================
// CONFIRMED WORKSHOPS — Booking details for confirmed requests
// Auto-created when status → "opdracht"
// ============================================================
model ConfirmedWorkshop {
  id                       Int       @id @default(autoincrement())
  requestId                Int       @unique @map("request_id")
  request                  WorkshopRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  confirmedDate            String    @map("confirmed_date")
  startTime                String?   @map("start_time")
  walkInTime               String?   @map("walk_in_time")
  actualParticipants       Int?      @map("actual_participants")
  location                 String?
  instructor               String?
  goeduitjeProvidesDrinks  Boolean   @default(false) @map("goeduitje_provides_drinks")
  goeduitjeProvidesGlasses Boolean   @default(false) @map("goeduitje_provides_glasses")
  allergies                String?
  dietaryRequirements      String?   @map("dietary_requirements")
  paymentStatus            String    @default("pending") @map("payment_status")
  paymentAmount            Decimal?  @map("payment_amount") @db.Decimal(10, 2)
  invoiceNumber            String?   @map("invoice_number")
  notes                    String?
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @default(now()) @map("updated_at")

  @@map("confirmed_workshops")
}

// ============================================================
// EMAIL CRM — Conversations & Messages
// Stores all email communication per workshop request.
// Supports drafts, sent items, and manually logged inbound replies.
// ============================================================

model EmailConversation {
  id            String    @id @default(cuid())
  requestId     Int       @unique @map("request_id")
  subject       String
  lastMessageAt DateTime  @default(now()) @map("last_message_at")
  isDraft       Boolean   @default(false) @map("is_draft")
  isRead        Boolean   @default(false) @map("is_read")
  isArchived    Boolean   @default(false) @map("is_archived")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  request  WorkshopRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  messages EmailMessage[]

  @@map("email_conversations")
  @@index([lastMessageAt])
  @@index([isRead])
}

model EmailMessage {
  id              String    @id @default(cuid())
  conversationId  String    @map("conversation_id")
  direction       String    @default("outbound") // "outbound" | "inbound"
  from            String
  to              String
  subject         String
  body            String    // Full HTML
  plainText       String?   @map("plain_text")
  templateKey     String?   @map("template_key")
  variables       Json?
  status          String    @default("draft") // "draft" | "sent" | "failed"
  sentAt          DateTime? @map("sent_at")
  resendId        String?   @unique @map("resend_id")
  attachmentUrls  String[]  @map("attachment_urls")
  attachmentNames String[]  @map("attachment_names")
  errorMessage    String?   @map("error_message")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  conversation EmailConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("email_messages")
  @@index([conversationId])
  @@index([status])
  @@index([sentAt])
  @@index([direction])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  subject   String
  body      String
  variables String[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model EmailLog {
  id           String   @id @default(cuid())
  templateKey  String
  to           String
  subject      String
  body         String
  variables    Json
  status       String   @default("sent")
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([templateKey])
  @@index([createdAt])
  @@index([to])
}

model WorkshopVariant {
  id          String      @id @default(cuid())
  workshopId  String
  name        String
  description String
  duration    String
  includes    String[]
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  priceTiers  PriceTier[]
  Workshop    Workshop    @relation(fields: [workshopId], references: [id], onDelete: Cascade)

  @@index([workshopId])
}

model google_reviews_cache {
  id               String   @id @default("singleton")
  placeId          String
  placeName        String?
  averageRating    Float?
  totalReviewCount Int?
  lastFetchedAt    DateTime @default(now())
  fetchErrorCount  Int      @default(0)
  lastErrorMessage String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ============================================================
// SESSION CHANGES
// Development change tracking for client validation
// Managed via backend admin at /wijzigingen
// ============================================================
model SessionChange {
  id              String    @id @default(cuid())
  title           String
  description     String?
  category        String?   // Contact, Navigation, Content, Design, Feature, Bug
  filesChanged    String[]  // Array of file paths
  changeDetails   String[]  // Bullet points describing the change
  viewUrl         String?   // Link to see change live
  screenshotUrls  String[]  // Multiple screenshot/image URLs (Vercel Blob)
  screenshotPaths String[]  // Blob paths for deletion
  status          String    @default("pending") // pending, approved, needs_changes, in_progress
  addedBy         String?   @default("developer") // developer or client
  deletedAt       DateTime? // Soft delete timestamp
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  feedback      SessionChangeFeedback[]

  @@map("session_changes")
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@index([deletedAt])
}

model SessionChangeFeedback {
  id              String   @id @default(cuid())
  changeId        String
  feedbackText    String?
  screenshotUrls  String[] // Multiple Vercel Blob URLs
  screenshotPaths String[] // Blob paths for deletion
  createdAt       DateTime @default(now())

  // Relations
  change         SessionChange @relation(fields: [changeId], references: [id], onDelete: Cascade)

  @@map("session_change_feedback")
  @@index([changeId])
}

// Status history for backup/restore of client approvals
model SessionChangeStatusHistory {
  id        String   @id @default(cuid())
  changeId  String
  status    String   // The status that was set
  changedBy String?  // Who made the change (client, developer, system)
  note      String?  // Optional note about the change
  createdAt DateTime @default(now())

  @@map("session_change_status_history")
  @@index([changeId])
  @@index([createdAt])
}

// ============================================================
// MEDIA GALLERY
// Workshop photos uploaded via backend admin for website display
// ============================================================
model MediaGallery {
  id           Int       @id @default(autoincrement())
  workshopId   Int?      @map("workshop_id") // Optional link to confirmed workshop

  // Vercel Blob Storage
  blobUrl      String    @map("blob_url")
  fileName     String    @map("file_name")
  fileSize     Int?      @map("file_size")
  mimeType     String    @map("mime_type")

  // Image Metadata
  width        Int?
  height       Int?
  caption      String?
  altText      String?   @map("alt_text")
  takenAt      DateTime? @map("taken_at")

  // Organization
  displayOrder Int       @default(0) @map("display_order")
  // Categories: Content images (workshop, setup, cooking, results, group, food, venue)
  //             Site assets (site-hero-video, site-hero-poster, site-logo, site-og)
  category     String?   @default("workshop")

  // Tagging
  tags         Json?     // Array of strings for search/filtering

  // Permissions & Display
  isPublic           Boolean @default(false) @map("is_public")
  showOnWebsite      Boolean @default(false) @map("show_on_website")
  featuredOnHomepage Boolean @default(false) @map("featured_on_homepage")

  // Uploaded By
  uploadedBy   String?   @map("uploaded_by")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")

  // Metadata
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("media_gallery")
  @@index([showOnWebsite])
  @@index([featuredOnHomepage])
  @@index([category])
  @@index([displayOrder])
}

// ============================================================
// ADMIN USERS TABLE
// Backend admin authentication (NextAuth credentials provider)
// Managed via backend Drizzle; Prisma model keeps it safe from db push
// ============================================================
model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         String    @default("admin") // 'admin' | 'instructor' | 'viewer'
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @map("updated_at")

  assignedRequests WorkshopRequest[]

  @@map("users")
}

// ============================================================
// STATUS AUDIT LOG — Tracks every status change on workshop requests
// ============================================================
model StatusAuditLog {
  id        String   @id @default(cuid())
  requestId Int      @map("request_id")
  oldStatus String   @map("old_status")
  newStatus String   @map("new_status")
  changedBy String?  @map("changed_by")
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  request WorkshopRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("status_audit_log")
  @@index([requestId])
  @@index([createdAt])
}

// ============================================================
// QUOTE VERSIONS — Stores every AI-generated quote for history
// ============================================================
model QuoteVersion {
  id           String    @id @default(cuid())
  requestId    Int       @map("request_id")
  version      Int       @default(1)
  emailContent String    @map("email_content")
  generatedAt  DateTime  @default(now()) @map("generated_at")
  generatedBy  String?   @map("generated_by")
  wasSent      Boolean   @default(false) @map("was_sent")
  sentAt       DateTime? @map("sent_at")

  request WorkshopRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@map("quote_versions")
  @@index([requestId])
}

// ============================================================
// QUOTE SETTINGS — Activities, Pricing Tiers, Locations, Drinks
// Used by the admin backend for AI quote generation.
// Managed via admin CRUD pages. NOT used by the frontend.
// ============================================================

model Activity {
  id              Int       @id @default(autoincrement())
  activityName    String    @map("activity_name")
  basePrice       Decimal   @map("base_price") @db.Decimal(10, 2)
  category        String    // 'cooking_workshop', 'city_game', etc.
  description     String?
  minParticipants Int       @default(1) @map("min_participants")
  maxParticipants Int?      @map("max_participants")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  pricingTiers QuotePricingTier[]

  @@map("activities")
}

model QuotePricingTier {
  id              Int       @id @default(autoincrement())
  activityId      Int       @map("activity_id")
  minParticipants Int       @map("min_participants")
  maxParticipants Int?      @map("max_participants")
  pricePerPerson  Decimal?  @map("price_per_person") @db.Decimal(10, 2)
  totalPrice      Decimal?  @map("total_price") @db.Decimal(10, 2)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("pricing_tiers")
  @@index([activityId])
}

model Location {
  id                      Int       @id @default(autoincrement())
  locationName            String    @map("location_name")
  city                    String
  minCapacity             Int?      @map("min_capacity")
  maxCapacity             Int?      @map("max_capacity")
  basePriceExclVat        Decimal   @map("base_price_excl_vat") @db.Decimal(10, 2)
  basePriceInclVat        Decimal   @map("base_price_incl_vat") @db.Decimal(10, 2)
  vatStatus               String    @default("regular") @map("vat_status") // 'regular' | 'exempt'
  drinksPolicy            String    @map("drinks_policy") // 'flexible' | 'via_location' | 'mandatory_via_location'
  goeduitjeDrinksAvailable Boolean  @default(false) @map("goeduitje_drinks_available")
  address                 String?
  contactPerson           String?   @map("contact_person")
  contactPhone            String?   @map("contact_phone")
  contactEmail            String?   @map("contact_email")
  notes                   String?
  isActive                Boolean   @default(true) @map("is_active")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  drinksPricing DrinksPricing[]

  @@map("locations")
}

model DrinksPricing {
  id           Int       @id @default(autoincrement())
  locationId   Int       @map("location_id")
  itemType     String    @map("item_type")  // 'beverage', 'package'
  itemName     String    @map("item_name")
  priceExclVat Decimal?  @map("price_excl_vat") @db.Decimal(10, 2)
  priceInclVat Decimal?  @map("price_incl_vat") @db.Decimal(10, 2)
  unit         String    @default("per_item") // 'per_item', 'per_person', 'per_bottle'
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("drinks_pricing")
  @@index([locationId])
}

# Database
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://user:password@localhost:5432/goeduitjefullstackwebsite?schema=public"

# Node Environment
NODE_ENV="development"

# Next.js (optional, uncomment if needed)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxx"
# Get webhook secret from Stripe CLI or Dashboard webhook settings
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxx"

# Optional: Stripe Price IDs (from Stripe Dashboard)
# STRIPE_PRICE_STARTER="price_xxxxxxxxxxxxx"
# STRIPE_PRICE_PRO="price_xxxxxxxxxxxxx"
# STRIPE_PRICE_ENTERPRISE="price_xxxxxxxxxxxxx"

# Resend (Email)
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxxxxx"
# Update this to your verified domain or use default for testing
FROM_EMAIL="onboarding@resend.dev"
SUPPORT_EMAIL="support@example.com"

# Skip environment validation (for Docker builds, etc.)
# SKIP_ENV_VALIDATION="true"
